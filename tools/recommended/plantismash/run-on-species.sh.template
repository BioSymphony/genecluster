#!/usr/bin/env bash
# tools/recommended/plantismash/run-on-species.sh.template
#
# STATUS: adaptation required; not-yet-tested. A plantiSMASH 2.0.4 tool
# baseline does not certify this wrapper.
#
# ADAPTATION REQUIRED:
#   Verify the input format, taxon option, CLI flags, and output files against
#   the pinned plantiSMASH release before use. Candidate regions require
#   independent normalization and review.
#
# What this template describes:
#   Run plantiSMASH 2.0.4 against a supported plant annotation input. The
#   command emits candidate region records and report files for review.
#
# Inputs:
#   {SPECIES_SLUG}     species slug
#   {GENOME_INPUT}     path to a supported plantiSMASH input file
#   {OUTPUT_DIR}       where to drop plantiSMASH outputs; conventionally
#                      .runtime/campaign-{species}-summary/superpowers/plantismash/
#
# Outputs:
#   ${OUTPUT_DIR}/*.gbk              , parsed plantiSMASH region records
#   ${OUTPUT_DIR}/index.html         , interactive web view
#
# Output use:
#   A separately reviewed normalizer can convert region records into candidate
#   cluster evidence. This template defines no downstream integration stage.

set -euo pipefail

SPECIES_SLUG="{SPECIES_SLUG}"               # species slug
GENOME_INPUT="{GENOME_INPUT}"               # path to supported plantiSMASH input
OUTPUT_DIR="{OUTPUT_DIR}"                   # absolute path
PLANTISMASH_CMD=(conda run -n plantismash plantismash)

mkdir -p "${OUTPUT_DIR}"

"${PLANTISMASH_CMD[@]}" \
  --taxon plants \
  --genefinding-tool none \
  --outputfolder "${OUTPUT_DIR}" \
  "${GENOME_INPUT}"

echo "ADAPTATION REQUIRED: review plantiSMASH output before downstream use: ${OUTPUT_DIR}"
