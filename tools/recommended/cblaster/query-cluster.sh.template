#!/usr/bin/env bash
# Local cblaster + clinker template. Replace every {PLACEHOLDER} and provide
# exactly one of ANNOTATED_GENOME or DB_PREFIX_OR_DMND.
#
# ANNOTATED_GENOME must be an annotated GenBank/EMBL file, or a GFF/GTF with
# its matching FASTA beside it. A prepared database needs both .dmnd and the
# sibling .sqlite3 produced by cblaster makedb.
# STATUS: wrapper contract only; biological validation remains required.

set -euo pipefail

ORGANISM="{ORGANISM}"
QUERY_FASTA="{QUERY_FASTA}"
ANNOTATED_GENOME="{ANNOTATED_GENOME}"
DATABASE_INPUT="{DB_PREFIX_OR_DMND}"
OUTPUT_DIR="{OUTPUT_DIR}"
MAX_GAP="{MAX_GAP}"
MIN_HITS="{MIN_HITS}"

fail() {
  echo "ERROR: $1" >&2
  exit "${2:-64}"
}

for value in "$ORGANISM" "$QUERY_FASTA" "$ANNOTATED_GENOME" "$DATABASE_INPUT" "$OUTPUT_DIR" "$MAX_GAP" "$MIN_HITS"; do
  [[ "$value" != *"{"* && "$value" != *"}"* ]] || fail "replace all template placeholders"
done
[[ "$ORGANISM" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] || fail "organism label is not safe"
[[ -f "$QUERY_FASTA" ]] || fail "query FASTA not found: $QUERY_FASTA" 65
[[ "$MAX_GAP" =~ ^[0-9]+$ ]] || fail "--gap must be a non-negative integer"
[[ "$MIN_HITS" =~ ^[1-9][0-9]*$ ]] || fail "--min-hits must be a positive integer"
if [[ -n "$ANNOTATED_GENOME" && -n "$DATABASE_INPUT" ]]; then
  fail "choose exactly one of ANNOTATED_GENOME or DB_PREFIX_OR_DMND"
fi
if [[ -z "$ANNOTATED_GENOME" && -z "$DATABASE_INPUT" ]]; then
  fail "provide an annotated genome or prepared database"
fi

for tool in cblaster clinker diamond; do
  command -v "$tool" >/dev/null 2>&1 || fail "'$tool' is not installed" 127
done
if [[ -e "$OUTPUT_DIR" ]]; then
  [[ -d "$OUTPUT_DIR" ]] || fail "output path is not a directory: $OUTPUT_DIR" 65
  if [[ -n "$(find "$OUTPUT_DIR" -mindepth 1 -maxdepth 1 -print -quit)" ]]; then
    fail "output directory is not empty; use a fresh output directory for each run: $OUTPUT_DIR" 65
  fi
fi
mkdir -p "$OUTPUT_DIR"

if [[ -n "$ANNOTATED_GENOME" ]]; then
  [[ -f "$ANNOTATED_GENOME" ]] || fail "annotated genome not found: $ANNOTATED_GENOME" 65
  case "$ANNOTATED_GENOME" in
    *.gff|*.gff3|*.gtf|*.gff.gz|*.gff3.gz|*.gtf.gz)
      GFF_BASE="${ANNOTATED_GENOME%.gz}"
      GFF_BASE="${GFF_BASE%.*}"
      GFF_FASTA_FOUND=""
      for suffix in .fa .fsa .fna .fasta; do
        if [[ -f "${GFF_BASE}${suffix}" ]]; then
          GFF_FASTA_FOUND="${GFF_BASE}${suffix}"
          break
        fi
      done
      [[ -n "$GFF_FASTA_FOUND" ]] || fail "GFF/GTF input needs a matching FASTA beside: $ANNOTATED_GENOME" 65
      ;;
  esac
  DB_PREFIX="${OUTPUT_DIR}/${ORGANISM}"
  DB_DMND="${DB_PREFIX}.dmnd"
  DB_SQLITE="${DB_PREFIX}.sqlite3"
  if [[ ! -f "$DB_DMND" || ! -f "$DB_SQLITE" ]]; then
    if [[ -e "$DB_DMND" || -e "$DB_SQLITE" ]]; then
      cblaster makedb "$ANNOTATED_GENOME" --name "$DB_PREFIX" --force
    else
      cblaster makedb "$ANNOTATED_GENOME" --name "$DB_PREFIX"
    fi
  fi
else
  case "$DATABASE_INPUT" in
    *.dmnd) DB_PREFIX="${DATABASE_INPUT%.dmnd}" ;;
    *.sqlite3) DB_PREFIX="${DATABASE_INPUT%.sqlite3}" ;;
    *) DB_PREFIX="$DATABASE_INPUT" ;;
  esac
  DB_DMND="${DB_PREFIX}.dmnd"
  DB_SQLITE="${DB_PREFIX}.sqlite3"
fi
[[ -f "$DB_DMND" && -f "$DB_SQLITE" ]] || fail "database needs $DB_DMND and $DB_SQLITE" 66

SESSION_JSON="${OUTPUT_DIR}/search-session.json"
SUMMARY_TSV="${OUTPUT_DIR}/clusters.tsv"
CLUSTERS_DIR="${OUTPUT_DIR}/clusters"
mkdir -p "$CLUSTERS_DIR"

cblaster search \
  --query_file "$QUERY_FASTA" \
  --mode local \
  --database "$DB_DMND" \
  --gap "$MAX_GAP" \
  --min_hits "$MIN_HITS" \
  --session_file "$SESSION_JSON" \
  --output "$SUMMARY_TSV" \
  --output_delimiter $'\t' \
  --plot "${OUTPUT_DIR}/cblaster.html"
[[ -f "$SESSION_JSON" ]] || fail "search did not write session JSON" 66

cblaster extract_clusters "$SESSION_JSON" \
  --output "$CLUSTERS_DIR" \
  --format genbank

shopt -s nullglob
gbks=("${CLUSTERS_DIR}"/*.gbk "${CLUSTERS_DIR}"/*.gb "${CLUSTERS_DIR}"/*.genbank)
if ((${#gbks[@]} == 0)); then
  echo "WARN: no GenBank clusters were produced; clinker skipped." >&2
else
  clinker "${gbks[@]}" --plot "${OUTPUT_DIR}/clinker.html"
fi

echo "DONE: ${ORGANISM} -> ${OUTPUT_DIR}"
