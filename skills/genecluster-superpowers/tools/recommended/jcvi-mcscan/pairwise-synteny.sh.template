#!/usr/bin/env bash
# tools/recommended/jcvi-mcscan/pairwise-synteny.sh.template
#
# STATUS: adaptation required; foundation only; not-yet-tested. A JCVI tool
# baseline does not certify this wrapper.
#
# ADAPTATION REQUIRED:
#   Use matching CDS FASTA files, verify GFF identifiers and BED conversion
#   options, and validate the LAST/MCScan commands against the pinned JCVI
#   release before use.
#
# What this template describes:
# Build a pairwise macro-synteny ribbon between two species using JCVI MCScan.
# The resulting anchors and plot provide order context for later review. They
# do not establish conserved function.
#
# Inputs:
# {SPECIES_A} species slug
# {SPECIES_B} species slug
# {SPECIES_A_GFF} path to A's annotation GFF
# {SPECIES_B_GFF} path to B's annotation GFF
# {SPECIES_A_CDS} path to A's matching CDS FASTA
# {SPECIES_B_CDS} path to B's matching CDS FASTA
# {OUTPUT_DIR} working dir; conventionally
# .runtime/jcvi-synteny/{A}-vs-{B}/
#
# Outputs:
# ${OUTPUT_DIR}/{A}.bed , JCVI-formatted gene table
# ${OUTPUT_DIR}/{B}.bed
# ${OUTPUT_DIR}/{A}.{B}.lifted.anchors , synteny anchor pairs
# ${OUTPUT_DIR}/{A}-vs-{B}-synteny.pdf , ribbon plot
#
# Output use:
# A separately reviewed normalizer can convert the BED and anchor files into
# synteny-block evidence. This template defines no downstream stage.

set -euo pipefail

SPECIES_A="{SPECIES_A}"
SPECIES_B="{SPECIES_B}"
SPECIES_A_GFF="{SPECIES_A_GFF}"
SPECIES_B_GFF="{SPECIES_B_GFF}"
SPECIES_A_CDS="{SPECIES_A_CDS}"
SPECIES_B_CDS="{SPECIES_B_CDS}"
OUTPUT_DIR="{OUTPUT_DIR}"

mkdir -p "${OUTPUT_DIR}"
cd "${OUTPUT_DIR}"

# 1. Convert each species' GFF to JCVI BED + stage CDS
python3 -m jcvi.formats.gff bed --type=mRNA --key=ID \
 "${SPECIES_A_GFF}" -o "${SPECIES_A}.bed"
python3 -m jcvi.formats.gff bed --type=mRNA --key=ID \
 "${SPECIES_B_GFF}" -o "${SPECIES_B}.bed"
ln -sf "${SPECIES_A_CDS}" "${SPECIES_A}.cds"
ln -sf "${SPECIES_B_CDS}" "${SPECIES_B}.cds"

# 2. JCVI MCScan pairwise ortholog-synteny pipeline
python3 -m jcvi.compara.catalog ortholog \
 "${SPECIES_A}" "${SPECIES_B}" \
 --no_strip_names

# 3. Render the synteny ribbon
# (seqids.txt + layout.txt are project-level; one-time hand edit per atlas)
python3 -m jcvi.graphics.synteny seqids.txt layout.txt \
 --outfile "${SPECIES_A}-vs-${SPECIES_B}-synteny.pdf"

echo "ADAPTATION REQUIRED: review JCVI outputs before downstream use: ${OUTPUT_DIR}"
