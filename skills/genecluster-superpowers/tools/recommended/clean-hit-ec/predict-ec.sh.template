#!/usr/bin/env bash
# tools/recommended/clean-hit-ec/predict-ec.sh.template
#
# STATUS: adaptation required; foundation only; not-yet-tested. A CLEAN tool
# baseline does not certify this wrapper.
#
# ADAPTATION REQUIRED:
#   Verify the CLEAN checkout, dependencies, FASTA identifiers, split argument,
#   and output names against the pinned CLEAN release before use.
#
# What this template describes:
#   Run CLEAN (contrastive-learning EC predictor, Yu Science 2023) on the
#   candidate proteins for one species. The output contains per-protein EC
#   label predictions for review with sequence, domain, and coordinate evidence.
#
# Inputs:
#   {QUERY_FASTA}        cluster-candidate FASTA
#                        e.g. .runtime/campaign-<species>-summary/cluster-candidates.faa
#   {OUTPUT_DIR}         where CLEAN writes results
#   {CLEAN_REPO}         path to local CLEAN clone (set by install-heavy.sh)
#   {SPLIT}              CLEAN split identifier; verify accepted values and
#                        interpretation for the pinned release
#
# Outputs:
#   ${OUTPUT_DIR}/{queryname}_maxsep.csv    , per-protein CLEAN result rows
#
# Output use:
#   A separately reviewed normalizer can convert these rows into function
#   evidence. This template does not define a downstream integration stage.

set -euo pipefail

QUERY_FASTA="{QUERY_FASTA}"
OUTPUT_DIR="{OUTPUT_DIR}"
CLEAN_REPO="{CLEAN_REPO}"          # e.g. tools/recommended/clean-hit-ec/src/CLEAN
SPLIT="{SPLIT}"                     # CLEAN split identifier

mkdir -p "${OUTPUT_DIR}"

# CLEAN expects to be run from its own directory
pushd "${CLEAN_REPO}" >/dev/null

python3 CLEAN_infer_fasta.py \
  --fasta_data "${QUERY_FASTA}" \
  --pretrained "${SPLIT}"

# Move outputs to our requested OUTPUT_DIR
mv results/*_maxsep.csv "${OUTPUT_DIR}/"

popd >/dev/null

echo "ADAPTATION REQUIRED: review CLEAN output before downstream use: ${OUTPUT_DIR}/"
