#!/usr/bin/env bash
# MMseqs2 iterative-profile.sh.template
#
# Replace the brace-delimited values before running this scaffold. It creates
# sequence databases, runs an MMseqs2 iterative-profile search, and writes a
# tab-separated result for downstream inspection. It does not infer
# orthology, compare search engines, or claim a recovery-rate improvement.
#
# Inputs:
#   {QUERY_FASTA}   query protein FASTA
#   {TARGET_FASTA}  target protein FASTA
#   {OUTPUT_DIR}    writable directory for databases, temporary files, and results
#   {THREADS}       positive integer, for example 8
#   {SENSITIVITY}   numeric MMseqs2 sensitivity passed to -s, for example 7.5
#
# Outputs:
#   ${OUTPUT_DIR}/queries-vs-target.outfmt6
#                   tab-separated columns:
#                   query,target,evalue,bits,qaln,taln
#   ${OUTPUT_DIR}/queries-vs-target.schema.txt
#                   the same comma-separated column list

set -euo pipefail

QUERY_FASTA="{QUERY_FASTA}"
TARGET_FASTA="{TARGET_FASTA}"
OUTPUT_DIR="{OUTPUT_DIR}"
THREADS="{THREADS}"
SENSITIVITY="{SENSITIVITY}"
FORMAT_OUTPUT="query,target,evalue,bits,qaln,taln"

if [[ -e "${OUTPUT_DIR}" && ! -d "${OUTPUT_DIR}" ]]; then
  echo "ERROR: output path exists and is not a directory: ${OUTPUT_DIR}" >&2
  exit 64
fi
if [[ -d "${OUTPUT_DIR}" ]]; then
  shopt -s nullglob dotglob
  OUTPUT_ENTRIES=("${OUTPUT_DIR}"/*)
  shopt -u nullglob dotglob
  if ((${#OUTPUT_ENTRIES[@]} != 0)); then
    echo "ERROR: output directory must be new or empty; refusing to reuse: ${OUTPUT_DIR}" >&2
    exit 64
  fi
fi

mkdir -p "${OUTPUT_DIR}/tmp"

# 1. Build query and target sequence databases.
mmseqs createdb "${QUERY_FASTA}" "${OUTPUT_DIR}/queries.db"
mmseqs createdb "${TARGET_FASTA}" "${OUTPUT_DIR}/target.db"

# 2. Iterative-profile search. MMseqs2 documents -s as its sensitivity flag.
mmseqs search \
  "${OUTPUT_DIR}/queries.db" \
  "${OUTPUT_DIR}/target.db" \
  "${OUTPUT_DIR}/queries-vs-target.result" \
  "${OUTPUT_DIR}/tmp" \
  --num-iterations 3 \
  -a \
  -s "${SENSITIVITY}" \
  --threads "${THREADS}"

# 3. Convert to a tabular file with an explicit, stable column list.
mmseqs convertalis \
  "${OUTPUT_DIR}/queries.db" \
  "${OUTPUT_DIR}/target.db" \
  "${OUTPUT_DIR}/queries-vs-target.result" \
  "${OUTPUT_DIR}/queries-vs-target.outfmt6" \
  --format-mode 0 \
  --format-output "${FORMAT_OUTPUT}"

[[ -f "${OUTPUT_DIR}/queries-vs-target.outfmt6" ]]
printf '%s\n' "${FORMAT_OUTPUT}" > "${OUTPUT_DIR}/queries-vs-target.schema.txt"

echo "MMseqs2 iterative profile -> ${OUTPUT_DIR}/queries-vs-target.outfmt6"
