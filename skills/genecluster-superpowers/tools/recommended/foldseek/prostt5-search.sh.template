#!/usr/bin/env bash
# tools/recommended/foldseek/prostt5-search.sh.template
#
# STATUS: adaptation required; foundation only; not-yet-tested. A Foldseek or
# ProstT5 tool baseline does not certify this wrapper.
#
# ADAPTATION REQUIRED:
#   Verify the target input type, model revision, CLI flags, and output fields
#   against the pinned Foldseek release before use.
#
# What this template describes:
# Run Foldseek easy-search using ProstT5 to encode candidate proteins from
# sequence alone. The output is a tabular structure-similarity result. It does
# not establish convergence, enzyme function, or a score threshold.
#
# Inputs:
# {QUERY_FASTA} path to cluster candidates FASTA, e.g.
# .runtime/campaign-<species>-summary/cluster-candidates.faa
# {TARGET_DB} Foldseek target database
# {OUTPUT_DIR} where to write outputs
# {THREADS} CPU thread count, e.g. 8
#
# Outputs:
# ${OUTPUT_DIR}/foldseek-hits.m8 , tabular hit table
# Columns: query, target, evalue, bits, alntmscore
#
# Output use:
# Compare the hit table with sequence, domain, and coordinate evidence after
# validating the score fields. This template defines no downstream stage.

set -euo pipefail

QUERY_FASTA="{QUERY_FASTA}"
TARGET_DB="{TARGET_DB}" # e.g. .runtime/databases/foldseek-afdb-swissprot/afdb-swissprot
OUTPUT_DIR="{OUTPUT_DIR}"
THREADS="{THREADS}" # e.g. 8

mkdir -p "${OUTPUT_DIR}"

foldseek easy-search \
 "${QUERY_FASTA}" \
 "${TARGET_DB}" \
 "${OUTPUT_DIR}/foldseek-hits.m8" \
 "${OUTPUT_DIR}/tmp" \
 --prostt5-model "Rostlab/ProstT5" \
 --threads "${THREADS}" \
 --format-output "query,target,evalue,bits,alntmscore"

echo "ADAPTATION REQUIRED: review Foldseek output before downstream use: ${OUTPUT_DIR}/foldseek-hits.m8"
